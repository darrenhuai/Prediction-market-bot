# Copy this file to .env and fill in what you need. Everything is optional:
# the web app and bot work without any of it, using demo or public data.
# Keep comments on their own lines; a comment after an empty value is read as the value.

# ---- Kalshi account (optional) ----------------------------------------
# Lets the app show your balance. Create a key in Kalshi under
# Account & security -> API keys. Kalshi gives you a key ID and downloads a
# private key file (RSA or Ed25519; both work). Keep that file outside this
# folder, or name it *.key or *.pem so git ignores it.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ---- Scanner settings (optional) -------------------------------------
# Anything you change on the app's Settings tab overrides these.

# Dollars you're willing to bet; used for stake suggestions (0 = off).
BANKROLL=0
# Smallest edge worth showing, in dollars per contract (0.02 = 2 cents).
MIN_EV_THRESHOLD=0.02
# Time between scans.
BOT_INTERVAL_SECONDS=300
# Smallest trade counted as "large", in contracts.
LARGE_TRADE_THRESHOLD=50
# Only scan these series, e.g. KXFED,KXHIGHNY (empty = everything).
WATCH_SERIES=
# Kalshi's standard fee rate.
KALSHI_FEE_RATE=0.07

# ---- Automatic trading -------------------------------------------------
# The app only ever places real orders if BOTH this is "yes" AND you set the
# mode to "live" on the Settings tab. Leave it at "no" while paper trading.
ALLOW_LIVE_TRADING=no

# ---- Email alerts (optional) ------------------------------------------
# For Gmail, use an app password, not your normal password.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587

# ---- Polymarket research tools (main.py) ------------------------------
# RPC endpoint for Polygon / Polymarket data reads.
POLYGON_RPC=

# Starting block used by Polymarket indexing jobs.
POLYMARKET_START_BLOCK=33605403
